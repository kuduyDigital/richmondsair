{
  "name": "richmondsair-website",
  "version": "1.0.0",
  "private": true,
  "description": "Richmond's Air website — HTML5, Tailwind CSS v4 and vanilla JavaScript",
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "build": "node scripts/build.js",
    "preview": "npx serve dist"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "lenis": "^1.3.27"
  }
}
